{
  "name": "electric-safai",
  "version": "1.0.0",
  "description": "⚡ Electric Safai - Powerful Elasticsearch CLI Tool | Saf (Certain Arsenic Fire) + AI (Artificial Intelligence)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "es-search": "./bin/search",
    "electric-safai": "./bin/search"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:watch": "tsc --watch",
    "lint": "bash scripts/lint.sh",
    "lint:check": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "bash scripts/test.sh",
    "test:unit": "bash scripts/test.sh --unit",
    "test:integration": "bash scripts/test.sh --integration",
    "test:coverage": "bash scripts/test.sh --coverage",
    "test:watch": "bash scripts/test.sh --watch",
    "cli": "bash scripts/run-cli.sh",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "db:setup": "bash scripts/setup-elasticsearch.sh",
    "db:create-index": "bash scripts/setup-elasticsearch.sh --create-index",
    "db:list": "bash scripts/setup-elasticsearch.sh --list",
    "seed": "bash scripts/seed-data.sh --seed",
    "seed:bulk": "bash scripts/seed-data.sh --bulk",
    "seed:clear": "bash scripts/seed-data.sh --clear",
    "seed:stats": "bash scripts/seed-data.sh --stats",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist/ coverage/",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lusionx/es-search.git"
  },
  "keywords": [
    "elasticsearch",
    "es",
    "search",
    "cli",
    "query",
    "electric-safai",
    "scroll",
    "aggregation",
    "bulk-delete"
  ],
  "author": "Liu Xing <lusionx@example.com>",
  "contributors": [
    "Electric Safai Team"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lusionx/es-search/issues"
  },
  "homepage": "https://github.com/lusionx/es-search#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "axios-mock-adapter": "^1.22.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
